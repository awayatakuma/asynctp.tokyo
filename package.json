{
  "name": "myportfolio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:links",
    "build": "next build",
    "build:links": "node scripts/prebuild-links.mjs",
    "analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --write",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "quality": "npm run format && npm run lint:fix && npm run type-check && npm run test",
    "quality:check": "npm run format:check && npm run lint && npm run type-check && npm run test",
    "info": "next info",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@chakra-ui/next-js": "^2.4.2",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/mdx": "^3.1.1",
    "@next/third-parties": "^16.3.2",
    "@pixiv/three-vrm": "^3.5.2",
    "@pixiv/three-vrm-animation": "^3.5.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@shikijs/rehype": "^4.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/mdx": "^2.0.13",
    "@types/three": "^0.170.0",
    "cheerio": "^1.1.0",
    "feed": "^5.1.0",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.2",
    "next-sitemap": "^4.2.3",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.0.2",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@next/bundle-analyzer": "^16.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "lint-staged": "^16.1.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "lib/**/!(linkMetadata).{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
